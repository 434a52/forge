<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>F8n</RootNamespace>
    <AssemblyName>F8n</AssemblyName>
  </PropertyGroup>

  <!-- The runner is its own executable project in a subdirectory; without this the library's
       default glob would compile its source into the library as well. -->
  <ItemGroup>
    <Compile Remove="RunVector/**" />
  </ItemGroup>

</Project>
